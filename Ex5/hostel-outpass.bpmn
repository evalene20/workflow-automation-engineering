    <bpmn:sequenceFlow id="Flow_0lf79hb" name="Warden" sourceRef="Gateway_04nky9y" targetRef="Activity_1v4tfpt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=valid and nights &gt;=1
</bpmn:conditionExpression>
