      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Approved_di" bpmnElement="EndEvent_Approved">
        <dc:Bounds x="1240" y="62" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1220" y="111" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1cetxwk_di" bpmnElement="Task_VerifyDocuments">
        <dc:Bounds x="250" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1bh0dtb_di" bpmnElement="Task_CheckEligibility">
        <dc:Bounds x="520" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0l0a6xs_di" bpmnElement="Task_DisburseLoan">
        <dc:Bounds x="1080" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_00quufx_di" bpmnElement="Task_SendRejection">
        <dc:Bounds x="1080" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_037m50b_di" bpmnElement="Task_RejectEligibility">
        <dc:Bounds x="800" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0hdzwap_di" bpmnElement="Task_RejectDocs">
        <dc:Bounds x="520" y="40" width="100" height="80" />
