          <dc:Bounds x="1384" y="170" width="67" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_OfferSent_di" bpmnElement="EndEvent_OfferSent">
        <dc:Bounds x="1400" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1377" y="292" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0c9bxlk_di" bpmnElement="Task_ScreenApplication">
        <dc:Bounds x="250" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0houc8o_di" bpmnElement="Task_GenerateOfferLetter">
        <dc:Bounds x="1240" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1ct7328_di" bpmnElement="Task_RejectHR">
        <dc:Bounds x="1240" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_00qwpno_di" bpmnElement="Task_RejectTech">
        <dc:Bounds x="960" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0jzk089_di" bpmnElement="Task_ScheduleHRRound">
        <dc:Bounds x="960" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0h7kfzk_di" bpmnElement="Task_EvaluateTechInterview">
        <dc:Bounds x="680" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0o1ouca_di" bpmnElement="Task_ScheduleTechInterview">
        <dc:Bounds x="520" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1m669x2_di" bpmnElement="Task_RejectScreening">
        <dc:Bounds x="520" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_RejectedScreening_di" bpmnElement="EndEvent_RejectedScreening">
        <dc:Bounds x="692" y="102" width="36" height="36" />
