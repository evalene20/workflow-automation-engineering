<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Recruitment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:process id="Process_Recruitment" name="Job Applicant Recruitment Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Job Application Submitted">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_Eligible" name="Meets Eligibility Criteria?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_NotEligible</bpmn:outgoing>
      <bpmn:outgoing>Flow_Eligible</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_RejectedScreening" name="Application Rejected (Screening)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_TechResult" name="Passed Technical Interview?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_TechFailed</bpmn:outgoing>
      <bpmn:outgoing>Flow_TechPassed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_RejectedTech" name="Application Rejected (Technical Interview)">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_HRResult" name="Selected in HR Round?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_HRRejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_HRSelected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_RejectedHR" name="Application Rejected (HR Round)">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_OfferSent" name="Offer Letter Sent">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_ScreenApplication" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ScreenApplication" targetRef="Gateway_Eligible" />
    <bpmn:sequenceFlow id="Flow_NotEligible" name="No" sourceRef="Gateway_Eligible" targetRef="Task_RejectScreening" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_RejectScreening" targetRef="EndEvent_RejectedScreening" />
    <bpmn:sequenceFlow id="Flow_Eligible" name="Yes" sourceRef="Gateway_Eligible" targetRef="Task_ScheduleTechInterview" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ScheduleTechInterview" targetRef="Task_EvaluateTechInterview" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_EvaluateTechInterview" targetRef="Gateway_TechResult" />
    <bpmn:sequenceFlow id="Flow_TechFailed" name="Fail" sourceRef="Gateway_TechResult" targetRef="Task_RejectTech" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_RejectTech" targetRef="EndEvent_RejectedTech" />
    <bpmn:sequenceFlow id="Flow_TechPassed" name="Pass" sourceRef="Gateway_TechResult" targetRef="Task_ScheduleHRRound" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ScheduleHRRound" targetRef="Gateway_HRResult" />
    <bpmn:sequenceFlow id="Flow_HRRejected" name="Rejected" sourceRef="Gateway_HRResult" targetRef="Task_RejectHR" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_RejectHR" targetRef="EndEvent_RejectedHR" />
    <bpmn:sequenceFlow id="Flow_HRSelected" name="Selected" sourceRef="Gateway_HRResult" targetRef="Task_GenerateOfferLetter" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_GenerateOfferLetter" targetRef="EndEvent_OfferSent" />
    <bpmn:serviceTask id="Task_ScreenApplication" name="Screen Application Against Eligibility Criteria">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GenerateOfferLetter" name="Generate &#38; Send Offer Letter">
      <bpmn:incoming>Flow_HRSelected</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_RejectHR" name="Send Rejection Notification">
      <bpmn:incoming>Flow_HRRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_RejectTech" name="Send Rejection Notification">
      <bpmn:incoming>Flow_TechFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_ScheduleHRRound" name="Schedule HR / Managerial Round">
      <bpmn:incoming>Flow_TechPassed</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EvaluateTechInterview" name="Evaluate Technical Interview Performance">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ScheduleTechInterview" name="Schedule Technical Interview">
      <bpmn:incoming>Flow_Eligible</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_RejectScreening" name="Send Rejection Notification">
      <bpmn:incoming>Flow_NotEligible</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:sendTask>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Recruitment">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="160" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="140" y="285" width="75" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
